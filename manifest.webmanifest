{
  "name": "تفريغ صوتي",
  "short_name": "تفريغ",
  "description": "تحويل التسجيلات والملاحظات الصوتية إلى نص عربي دقيق عبر OpenRouter",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "/tafregh/",
  "scope": "/tafregh/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f766e",
  "theme_color": "#0f766e",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/tafregh/?shared=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            ".m4a",
            ".mp3",
            ".wav",
            ".ogg",
            ".opus",
            ".caf",
            ".webm",
            ".aac",
            ".flac",
            "video/*"
          ]
        }
      ]
    }
  }
}
